<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_surface"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- CVE ID + Severity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_cve_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CVE-2024-0001"
            android:textColor="@color/cyan_primary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_severity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HIGH"
            android:textColor="@color/risk_high"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_risk_high"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"/>

    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vulnerability description goes here..."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_marginBottom="8dp"/>

    <!-- Published Date -->
    <TextView
        android:id="@+id/tv_published"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Published: 2024-01-01"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"/>

</LinearLayout>