<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

<!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APP DETAIL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="12dp"/>

        <!-- L2: ConstraintLayout Profile Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.22"/>

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/ic_avatar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/guideline_start"/>

            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="WhatsApp Messenger"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginStart="14dp"
                app:layout_constraintTop_toTopOf="@id/iv_avatar"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="v2.23.11 · com.whatsapp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tv_app_name"
                app:layout_constraintStart_toEndOf="@id/guideline_start"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="iv_avatar,tv_version"/>

            <TextView
                android:id="@+id/tv_risk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH RISK"
                android:textColor="@color/risk_high"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_risk_high"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/barrier"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_api"
                app:layout_constraintHorizontal_chainStyle="spread_inside"/>

            <TextView
                android:id="@+id/tv_api"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API 21"
                android:textColor="@color/risk_medium"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_surface"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/barrier"
                app:layout_constraintStart_toEndOf="@id/tv_risk"
                app:layout_constraintEnd_toStartOf="@id/tv_cleartext"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_risk"/>

            <TextView
                android:id="@+id/tv_cleartext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLEARTEXT"
                android:textColor="@color/cyan_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_cyan_tag"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/barrier"
                app:layout_constraintStart_toEndOf="@id/tv_api"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_risk"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_cleartext"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- L5: FrameLayout Notification Hub -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTIFICATION HUB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:background="@drawable/bg_surface"
                android:layout_gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔"
                    android:textSize="24sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="3"
                android:textSize="10sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_badge"
                android:layout_gravity="top|end"/>

        </FrameLayout>

        <!-- L4: RelativeLayout Permission Rows -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERMISSION DETAILS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <!-- Row 1 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/perm_icon1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="📍"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/perm_name1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/perm_icon1"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="-22dp"
                android:layout_toRightOf="@id/perm_icon1"
                android:text="ACCESS_FINE_LOCATION"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/perm_status1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANGEROUS"
                android:textColor="@color/risk_high"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <!-- Row 2 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/perm_icon2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="📷"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/perm_name2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/perm_icon2"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="-23dp"
                android:layout_toRightOf="@id/perm_icon2"
                android:text="CAMERA"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/perm_status2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANGEROUS"
                android:textColor="@color/risk_high"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <!-- Row 3 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/perm_icon3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="🎤"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/perm_name3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/perm_icon3"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="-18dp"
                android:layout_toRightOf="@id/perm_icon3"
                android:text="RECORD_AUDIO"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/perm_status3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NORMAL"
                android:textColor="@color/risk_safe"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <!-- Row 4 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/perm_icon4"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="👥"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/perm_name4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/perm_icon4"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="-19dp"
                android:layout_toRightOf="@id/perm_icon4"
                android:text="READ_CONTACTS"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/perm_status4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANGEROUS"
                android:textColor="@color/risk_high"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <!-- Row 5 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/perm_icon5"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="💾"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/perm_name5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/perm_icon5"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="11dp"
                android:layout_marginTop="-18dp"
                android:layout_toRightOf="@id/perm_icon5"
                android:text="WRITE_EXTERNAL_STORAGE"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/perm_status5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANGEROUS"
                android:textColor="@color/risk_high"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

    </LinearLayout>
</ScrollView>