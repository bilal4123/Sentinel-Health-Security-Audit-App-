<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customize Sentinel"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp"/>

        <!-- Scan Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCAN MODE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/rg_scan_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface"
            android:padding="8dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_quick"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="⚡ Quick Scan — Checks permissions only"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:checked="true"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <RadioButton
                android:id="@+id/rb_deep"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔬 Deep Scan — Full manifest analysis"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <RadioButton
                android:id="@+id/rb_scheduled"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🕐 Scheduled — Runs automatically"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

        </RadioGroup>

        <!-- Display Theme -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISPLAY THEME"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/rg_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface"
            android:padding="8dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_dark"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🌑 Dark Theme"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:checked="true"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <RadioButton
                android:id="@+id/rb_light"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="☀️ Light Theme"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <RadioButton
                android:id="@+id/rb_system"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔄 Follow System"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

        </RadioGroup>

        <!-- Notifications -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTIFICATIONS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Threat Alerts"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <Switch
                android:id="@+id/sw_threat_alerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="@color/cyan_primary"
                android:trackTint="@color/bg_elevated"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Weekly Report"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <Switch
                android:id="@+id/sw_weekly_report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumbTint="@color/cyan_primary"
                android:trackTint="@color/bg_elevated"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📲 Auto Scan on Install"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <Switch
                android:id="@+id/sw_auto_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="@color/cyan_primary"
                android:trackTint="@color/bg_elevated"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <!-- About -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABOUT"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Version"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.0"
                android:textColor="@color/cyan_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

    </LinearLayout>
</ScrollView>