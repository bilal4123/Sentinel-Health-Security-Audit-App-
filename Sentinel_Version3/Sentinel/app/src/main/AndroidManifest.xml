<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.GET_PACKAGE_SIZE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ss"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ss"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sentinel"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <!-- ONLY ONE LAUNCHER ACTIVITY - ComposeLoginActivity -->
        <activity
            android:name=".activities.ComposeActivity"
            android:exported="true"
            android:theme="@style/Theme.Sentinel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Splash Activity - NO launcher -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.Sentinel" />

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Sentinel" />

        <!-- App Detail Activity -->
        <activity
            android:name=".activities.AppDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Sentinel" />

        <!-- Threat Detail Activity (Compose) -->
        <activity
            android:name=".activities.ThreatDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Sentinel" />

        <!-- Remove ComposeActivity if not needed, or keep without launcher -->
        <!-- <activity
            android:name=".activities.ComposeActivity"
            android:exported="false"
            android:theme="@style/Theme.Sentinel" /> -->

        <!-- FCM Service - MUST be INSIDE application tag -->
        <service
            android:name=".notifications.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Firebase Metadata -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_shield" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/cyan_primary" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

</manifest>