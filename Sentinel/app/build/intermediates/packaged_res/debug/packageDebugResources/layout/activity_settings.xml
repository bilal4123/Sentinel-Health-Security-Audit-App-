<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customize Sentinel"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp"/>

        <!-- Section: Scan Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCAN MODE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <!-- L9: RadioGroup Scan Mode -->
        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface"
            android:padding="8dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="⚡  Quick Scan — Checks permissions only"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:checked="true"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔬  Deep Scan — Full manifest analysis"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🕐  Scheduled — Runs automatically"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

        </RadioGroup>

        <!-- Section: Display Theme -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISPLAY THEME"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <!-- L9: RadioGroup Theme -->
        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface"
            android:padding="8dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🌑  Dark Theme"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:checked="true"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="☀️  Light Theme"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔄  Follow System"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/cyan_primary"
                android:padding="10dp"/>

        </RadioGroup>

        <!-- Section: Notifications -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTIFICATIONS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_notif1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴  Threat Alerts"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="@color/cyan_primary"
                android:trackTint="@color/bg_elevated"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_notif2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊  Weekly Report"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumbTint="@color/cyan_primary"
                android:trackTint="@color/bg_elevated"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_notif3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📲  Auto Scan on Install"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="@color/cyan_primary"
                android:trackTint="@color/bg_elevated"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <!-- Section: About -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABOUT"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan_primary"
            android:layout_marginBottom="10dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_version_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Version"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.0"
                android:textColor="@color/cyan_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_build"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Build"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Release 2026"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

    </LinearLayout>
</ScrollView>