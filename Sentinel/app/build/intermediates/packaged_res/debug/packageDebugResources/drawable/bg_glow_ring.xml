<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A00E5FF"/>
            <stroke
                android:width="1dp"
                android:color="#3300E5FF"/>
        </shape>
    </item>

    <!-- Middle ring -->
    <item
        android:top="8dp"
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="oval">
            <solid android:color="#0D1526"/>
            <stroke
                android:width="2dp"
                android:color="#6600E5FF"/>
        </shape>
    </item>

    <!-- Inner ring -->
    <item
        android:top="16dp"
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="#070B14"/>
            <stroke
                android:width="2dp"
                android:color="#00E5FF"/>
        </shape>
    </item>

</layer-list>